# ---------------------------------------------------------------------------
# PDF 打印扫描模拟器 —— .gitignore
#
# 原则：只提交源码与文档，构建产物、运行时数据、测试输出都不入库。
# 单个文件超过 50MB GitHub 会警告，超过 100MB 直接拒绝推送，
# 而打包出来的 exe 有 48MB，放进仓库会迅速把克隆体积撑爆。
#
# 注意：Git 的 .gitignore 不支持行尾注释，# 必须单独占一行。
# ---------------------------------------------------------------------------

# ---- 构建产物 ----
/dist/
/build/
*.spec
*.exe

# ---- 运行时数据（属于本机数据，不应入库）----
/logs/
/config/
/output/

# ---- 代理工作区数据 ----
/.workbuddy/

# ---- 测试输出（测试脚本本身在 tools/ 里，会提交）----
/test/out/
/test/cmp/
/test/ui/
/test/selftest_*
__pycache__/
*.py[cod]
*.egg-info/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---- 临时文件 ----
*.tmp
*.bak
*~
